generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ORGANIZER
  CLIENT
  GATE
}

model User {
  id           String         @id @default(uuid())
  name         String
  email        String         @unique
  passwordHash String
  role         Role
  reservations Reservation[]
  tickets      Ticket[]
  createdAt    DateTime       @default(now())
}

model PublishedEvent {
  id             String         @id @default(uuid())
  ticketmasterId String         @unique
  name           String
  imageUrl       String?
  startDate      String?
  startTime      String?
  venueName      String?
  venueCity      String?
  venueStateCode String?
  currency       String         @default("BRL")
  unitPrice      Decimal        @db.Decimal(10, 2)
  description    String?
  seats          Seat[]
  reservations   Reservation[]
  createdAt      DateTime       @default(now())
}

enum SeatStatus {
  AVAILABLE
  SOLD
}

model Seat {
  id            String         @id @default(uuid())
  eventId       String
  event         PublishedEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  row           String
  number        Int
  status        SeatStatus     @default(AVAILABLE)
  reservationId String?
  reservation   Reservation?   @relation(fields: [reservationId], references: [id])
  ticket        Ticket?
  createdAt     DateTime       @default(now())

  @@unique([eventId, row, number])
}

enum ReservationStatus {
  PAID
  REFUSED
}

model Reservation {
  id        String             @id @default(uuid())
  eventId   String
  event     PublishedEvent     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId    String
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  status    ReservationStatus
  total     Decimal            @db.Decimal(10, 2)
  currency  String
  seats     Seat[]
  tickets   Ticket[]
  createdAt DateTime           @default(now())
}

enum TicketStatus {
  VALID
  USED
  CANCELLED
}

model Ticket {
  id            String       @id @default(uuid())
  code          String       @unique
  shareToken    String       @unique
  status        TicketStatus @default(VALID)
  usedAt        DateTime?
  cancelledAt   DateTime?
  userId        String
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  reservationId String
  reservation   Reservation  @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  seatId        String?      @unique
  seat          Seat?        @relation(fields: [seatId], references: [id], onDelete: Cascade)
  seatRow       String
  seatNumber    Int
  createdAt     DateTime     @default(now())
}
